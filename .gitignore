.atmux/*
!.atmux/team.json
# ADR-244 — machine-death backup via pre-commit hook. Recovery-relevant
# files allowlisted; transient state (locks, budget caches, debounce,
# cost telemetry) stays gitignored to keep commit noise floor at zero.
# Pattern note: parent `.atmux/*` excludes subdirectories non-recursively,
# so we unignore the dir FIRST, then re-exclude its transient contents,
# then unignore the specific recovery file. Mirrors the standard gitignore
# nested-pattern dance (cf. `git help ignore` examples).
!.atmux/decisions.md
!.atmux/decisions/
!.atmux/state/
.atmux/state/*
!.atmux/state/kanban.sqlite
.claude/team.json
.claude/settings.json
.claude/scheduled_tasks.lock
.DS_Store
*.log
node_modules/
tmp/

# TS port (PLAN.md, atmux-bun)
coverage/
dist/
.bun/

# Bash decommission archives (kept only in working tree, not git history)
.archive-bash-atmux-*/

# Local worktree caches
.claude/worktrees/

# Rust build artifacts (rust/atmux-listener/target)
rust/*/target/

# Local scratch dirs (test fixtures during dev)
.scratch/
