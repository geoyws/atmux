{
  "_comment": "Recommended Cursor CLI permissions for atmux member cages. Merge into ~/.cursor/cli-config.json and/or <repo>/.cursor/cli.json. Pair with spawn: cursor-agent --force --approve-mcps (see src/core/tui-cmd.ts). Deny always wins over --force.",
  "approvalMode": "allowlist",
  "permissions": {
    "allow": [
      "Shell(git)",
      "Shell(bun)",
      "Shell(pnpm)",
      "Shell(node)",
      "Shell(npx)",
      "Shell(mise)",
      "Shell(bash)",
      "Shell(sh)",
      "Shell(zsh)",
      "Shell(docker)",
      "Shell(curl)",
      "Shell(jq)",
      "Shell(rg)",
      "Shell(grep)",
      "Shell(find)",
      "Shell(ls)",
      "Shell(cat)",
      "Shell(mkdir)",
      "Shell(cp)",
      "Shell(mv)",
      "Shell(touch)",
      "Shell(chmod)",
      "Shell(sed)",
      "Shell(awk)",
      "Shell(tmux)",
      "Shell(atmux)",
      "Shell(playwright)",
      "Shell(timeout)",
      "Shell(pkill)",
      "Shell(pg_isready)",
      "Shell(psql)",
      "Read(**)",
      "Write(/root/work/**)",
      "Write(/tmp/atmux-*/**)",
      "Write(/tmp/**)",
      "WebFetch(cursor.com)",
      "WebFetch(*.cursor.com)",
      "WebFetch(github.com)",
      "WebFetch(*.github.com)",
      "WebFetch(dev.azure.com)",
      "WebFetch(*.ifca.app)",
      "WebFetch(localhost)",
      "WebFetch(127.0.0.1)"
    ],
    "deny": [
      "Shell(rm)",
      "Shell(git push:--force*)",
      "Shell(git push:-f*)",
      "Shell(git push:--force-with-lease*)",
      "Shell(ssh)",
      "Shell(scp)",
      "Shell(sudo)",
      "Read(**/.env*)",
      "Read(**/credentials*)",
      "Read(**/*.pem)",
      "Read(/root/.ssh/**)",
      "Write(**/.env*)",
      "Write(**/credentials*)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(/root/.ssh/**)",
      "Write(/etc/**)"
    ]
  }
}
