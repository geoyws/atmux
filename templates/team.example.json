{
  "name": "my-team",
  "description": "atmux team — edit this to match your project",
  "tmuxTmpdir": "/tmp/atmux-tmux-my-team",
  "_comment_singleSession": "Default true per ADR-026 — driver + members share one tmux session for at-a-glance state. Set false ONLY for non-human-driven teams or detached observer setups (declared escape hatch, no longer wizard-prompted).",
  "singleSession": true,
  "tuiCommands": {
    "_comment": "Per-team TUI launch aliases. If set, the prefix here replaces the built-in default for that TUI type. atmux appends --model <model> unless the prefix already has one. Example: \"claude\": \"claude --plugin-dir=$HOME/work/journals/.sb/claude-skills\""
  },
  "emojis": {
    "mode": "random"
  },
  "members": [
    {
      "name": "lead",
      "role": "team-lead",
      "lane": "misc",
      "tui": "claude",
      "model": "default",
      "cwd": "."
    },
    {
      "name": "planner",
      "role": "planner",
      "lane": "misc",
      "tui": "claude",
      "model": "default",
      "cwd": "."
    },
    {
      "name": "reviewer",
      "role": "reviewer",
      "lane": "review",
      "tui": "claude",
      "model": "default",
      "cwd": "."
    },
    {
      "name": "gitter",
      "role": "gitter",
      "lane": "misc",
      "tui": "claude",
      "model": "default",
      "cwd": "."
    },
    {
      "name": "devops",
      "role": "devops",
      "lane": "ops",
      "tui": "claude",
      "model": "default",
      "cwd": "."
    },
    {
      "name": "dba",
      "role": "dba",
      "lane": "db",
      "tui": "claude",
      "model": "default",
      "cwd": "."
    },
    {
      "name": "unblocker",
      "role": "unblocker",
      "lane": "misc",
      "tui": "claude",
      "model": "default",
      "cwd": "."
    },
    {
      "name": "discorder",
      "role": "discorder",
      "lane": "misc",
      "tui": "claude",
      "model": "claude-sonnet-4-6",
      "cwd": "."
    },
    {
      "name": "fe-auth",
      "role": "member",
      "lane": "fe",
      "tui": "claude",
      "model": "default",
      "cwd": "."
    },
    {
      "name": "be-auth",
      "role": "member",
      "lane": "be",
      "tui": "cursor",
      "model": "default",
      "cwd": "."
    },
    {
      "name": "db-auth",
      "role": "member",
      "lane": "db",
      "tui": "opencode",
      "model": "default",
      "cwd": "."
    }
  ],
  "whip": {
    "intervalMins": 5,
    "staleMin": 90,
    "leadMaxMin": 60,
    "autoRotate": true
  },
  "report": {
    "intervalMins": 30
  },
  "_comment_discord": "Optional. webhook = pings target (env ATMUX_DISCORD_WEBHOOK overrides). color = hex override for embed (auto-derived from team-name hash if absent, see ADR-019 §16-color palette). emoji = leading title glyph (defaults to 🤖). Strip any field to fall back to defaults.",
  "discord": {
    "webhook": "https://discord.com/api/webhooks/REPLACE_ME",
    "color": "#7287fd",
    "emoji": "🌊"
  }
}
