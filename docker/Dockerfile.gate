# atmux Linux gate image — bun + the native deps the suite shells out to.
#
# The unit suite spawns `tmux` (fixture cages), `git` (worktree/show-toplevel
# probes) and `jq` (config-shape assertions in a few helpers). oven/bun
# ships none of those; this layer adds them on Debian trixie.
#
# zsh is required: templates/tmux/atmux.conf sets default-command to
# `exec zsh -l -i`, so without zsh every fresh pane dies at once and the
# real-tmux tests read "expected exactly one fresh window" (t-4716165e).
# The zsh new-user wizard is removed so a pane in an empty test HOME gets a
# prompt instead of an interactive menu.
#
# tmux is the PINNED version (tmux/PINNED_VERSION, ADR-191), built from the
# checksum-verified release tarball by scripts/build-vendored-tmux.sh and
# installed at /opt/atmux/<v>/bin/tmux with /opt/atmux/current and
# /usr/local/bin/tmux pointing at it — never the distro package (trixie ships
# 3.5a), so the gate measures the tmux atmux ships. The container has no UTF-8
# locale; atmux passes tmux -u on every client call for that (ADR-307).
#
# Base pinned by digest (recorded 2026-09-28; bump deliberately, never float):
#   oven/bun@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895
#
# Build:  docker build -f docker/Dockerfile.gate -t atmux-gate:<tag> .
#         (scripts/gate-linux.sh tags by a hash of this file + the pin
#         inputs, so an edit here or a pin bump forces a rebuild.)
# Digest: docker inspect atmux-gate:<tag> --format='{{index .RepoDigests 0}}'
#         (empty until pushed — receipts cite the base digest above plus the
#         local image ID from `docker images atmux-gate --format '{{.ID}}'`).

FROM oven/bun@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895

RUN apt-get update \
  && apt-get install -y --no-install-recommends git jq procps zsh \
     curl ca-certificates build-essential bison pkg-config libevent-dev libncurses-dev \
  && rm -rf /var/lib/apt/lists/* \
  && find /usr/share/zsh -path '*/scripts/newuser' -delete \
  && test "$(cd "$(mktemp -d)" && HOME="$PWD" zsh -l -i -c 'print ok' </dev/null 2>&1)" = ok

COPY tmux/PINNED_VERSION tmux/SHA256SUMS /build/tmux/
COPY scripts/build-vendored-tmux.sh /build/scripts/
RUN v="$(tr -d '[:space:]' < /build/tmux/PINNED_VERSION)" \
  && bash /build/scripts/build-vendored-tmux.sh --stage "/opt/atmux/$v" \
  && ln -s "/opt/atmux/$v" /opt/atmux/current \
  && ln -s /opt/atmux/current/bin/tmux /usr/local/bin/tmux \
  && rm -rf /build \
  && test "$(tmux -V)" = "tmux $v"

WORKDIR /repo
