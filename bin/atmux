#!/usr/bin/env bash
# atmux — tmux-native multi-TUI agent orchestrator.
# Dispatcher: routes `atmux <verb> [args]` to lib/<verb>.sh.

set -euo pipefail

# Resolve the real location of this script, following symlinks so a
# `/usr/local/bin/atmux` symlink still finds lib/ + templates/ correctly.
_atmux_self="${BASH_SOURCE[0]}"
while [[ -L "$_atmux_self" ]]; do
  _atmux_dir="$(cd -P "$(dirname "$_atmux_self")" && pwd)"
  _atmux_self="$(readlink "$_atmux_self")"
  [[ "$_atmux_self" != /* ]] && _atmux_self="$_atmux_dir/$_atmux_self"
done
ATMUX_BIN_DIR="$(cd -P "$(dirname "$_atmux_self")" && pwd)"
ATMUX_ROOT="$(cd "$ATMUX_BIN_DIR/.." && pwd)"
unset _atmux_self _atmux_dir
export ATMUX_ROOT ATMUX_BIN_DIR
export ATMUX_LIB_DIR="$ATMUX_ROOT/lib"
export ATMUX_TEMPLATES_DIR="$ATMUX_ROOT/templates"

# shellcheck source=../lib/common.sh
. "$ATMUX_LIB_DIR/common.sh"

usage() {
  cat <<'EOF'
atmux — tmux-native multi-TUI agent orchestrator.

Usage: atmux <verb> [args]

Setup:
  init [--name <team>]        Scaffold .atmux/team.json in current dir
  start                       Create tmux session, spawn all members
  stop [--force]              Kill tmux session, archive state
  attach                      tmux attach to the team session
  status                      Powerline team overview

Messaging:
  send <member> <msg...>      tmux send-keys to a member's pane
  broadcast <msg...>          Send to every member except the driver
  tell-lead <msg...>          Driver-only: send to lead + append to driver-inbox.md
  reply <msg...>              Member → driver: write to lead-outbox.md
  outbox [--ack] [--json]     Driver: read lead-outbox.md (--ack archives)

Task board (kanban):
  task add <subject> [--body <text>] [--assignee <member>] [--deps <id,id>]
  task list [--status todo|in-progress|done|blocked] [--assignee <member>]
  task show <id>
  task move <id> <todo|in-progress|done|blocked>

Dispatch + work:
  dispatch <member> <task-id> Push task to member's inbox + ping them
  inbox <member>              Show member's inbox
  claim <task-id>             Claim a task from kanban (as a member)
  done <task-id>              Mark claimed task complete

Automation:
  report                      Post 30-min progress digest to Discord
  whip                        Run 5-min watchdog (idle / blocker / budget / clear)
  cost [--member <m>] [--since <t>] [--json]  Per-member USD + token usage
  rotate <member>             /clear the member and re-brief
  rotate-lead                 /clear the lead and re-bootstrap
  handoff <from> <to>         Move in-flight work from one member to another
  pause <member>              Mark member paused (dispatch refuses to queue)
  resume <member>             Unpause

Maintenance:
  add-member <name> --role <r> --tui <t> [--model <m>] [--cwd <d>] [--command <c>]
  reconfigure                 Re-run wizard against an existing team.json
  dashboard [--interval <s>]  Live full-screen status panel

Misc:
  version
  help | --help | -h

Environment:
  ATMUX_DISCORD_WEBHOOK   Discord webhook URL for whip/report escalations
  ATMUX_DIR               Override state dir (default: ./.atmux)
  ATMUX_TEAM              Override team name (otherwise read from team.json)

Docs:  https://github.com/geoyws/atmux
EOF
}

case "${1:-}" in
  ""|help|--help|-h) usage; exit 0 ;;
  version|--version|-V) echo "atmux $(atmux::version)"; exit 0 ;;
esac

verb="$1"; shift
verb_script="$ATMUX_LIB_DIR/${verb}.sh"

# Route aliased verbs:
case "$verb" in
  tell-lead) verb_script="$ATMUX_LIB_DIR/tell.sh" ;;
  rotate-lead) verb_script="$ATMUX_LIB_DIR/rotate.sh"; set -- "--lead" "$@" ;;
  task) verb_script="$ATMUX_LIB_DIR/kanban.sh" ;;
  broadcast) verb_script="$ATMUX_LIB_DIR/send.sh"; set -- "--broadcast" "$@" ;;
  claim|done) verb_script="$ATMUX_LIB_DIR/claim.sh"; set -- "--$verb" "$@" ;;
  reply) verb_script="$ATMUX_LIB_DIR/reply.sh"; set -- "--reply" "$@" ;;
  outbox) verb_script="$ATMUX_LIB_DIR/reply.sh"; set -- "--outbox" "$@" ;;
  pause|resume) verb_script="$ATMUX_LIB_DIR/pause.sh"; set -- "$verb" "$@" ;;
esac

if [[ ! -f "$verb_script" ]]; then
  echo "atmux: unknown verb: $verb" >&2
  echo "  run 'atmux help' for the list of verbs" >&2
  exit 64
fi

# First-run auto-wizard: if there's no team.json, no --team override, and this
# isn't a verb that sets up / explains atmux itself, offer to run the wizard.
case "$verb" in
  init|wizard) ;;  # these don't need a team to already exist
  *)
    if [[ -z "${ATMUX_TEAM:-}" ]]; then
      atmux::maybe_offer_wizard || true
    fi
    ;;
esac

# shellcheck disable=SC1090
. "$verb_script"
# Each lib/*.sh defines a main() function which we invoke here.
if declare -F main >/dev/null; then
  main "$@"
else
  echo "atmux: lib/$verb.sh missing main()" >&2
  exit 70
fi
