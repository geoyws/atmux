{
  "name": "opencode-lead",
  "description": "OpenCode driving as team-lead (cheap coordination turns), Claude for reviewer/gitter, Cursor + Kimi workers.",
  "tuiCommands": {
    "_comment": "Edit these to match your actual aliases / binaries.",
    "claude": "claude",
    "opencode": "opencode --model minimax-coding-plan/MiniMax-M2.7-highspeed",
    "cursor": "cursor-agent",
    "kimi": "kimi"
  },
  "members": [
    { "name": "lead",        "role": "team-lead",     "tui": "opencode", "model": "default", "cwd": "." },
    { "name": "reviewer",    "role": "reviewer",      "tui": "claude",   "model": "default", "cwd": "." },
    { "name": "gitter",      "role": "git-committer", "tui": "claude",   "model": "default", "cwd": "." },
    { "name": "ui-cursor",   "role": "member",        "tui": "cursor",   "model": "default", "cwd": "." },
    { "name": "api-kimi",    "role": "member",        "tui": "kimi",     "model": "default", "cwd": "." }
  ],
  "whip":   { "intervalMins": 5, "staleMin": 30, "leadMaxMin": 60 },
  "report": { "intervalMins": 30 }
}
